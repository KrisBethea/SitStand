<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SitStand.App.ViewModels"
        x:Class="SitStand.App.Views.DashboardWindow"
        x:DataType="vm:DashboardViewModel"
        Title="SitStand — Dashboard"
        Width="720" Height="560"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.tile">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinWidth" Value="128" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>
    <Style Selector="Border.tile TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="Border.tile TextBlock.value">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.col">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="14">
      <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" />

      <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
        <Border Classes="tile">
          <StackPanel>
            <TextBlock Classes="label" Text="Movement breaks" />
            <TextBlock Classes="value" Text="{Binding MovementBreaks}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel>
            <TextBlock Classes="label" Text="Longest sit" />
            <TextBlock Classes="value" Text="{Binding LongestSit}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel>
            <TextBlock Classes="label" Text="Average sit" />
            <TextBlock Classes="value" Text="{Binding AverageSit}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel>
            <TextBlock Classes="label" Text="Sitting" />
            <TextBlock Classes="value" Text="{Binding Sitting}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel>
            <TextBlock Classes="label" Text="Standing" />
            <TextBlock Classes="value" Text="{Binding Standing}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel>
            <TextBlock Classes="label" Text="Moving" />
            <TextBlock Classes="value" Text="{Binding Moving}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel>
            <TextBlock Classes="label" Text="Away" />
            <TextBlock Classes="value" Text="{Binding Away}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel>
            <TextBlock Classes="label" Text="Reminders" />
            <TextBlock Classes="value" Text="{Binding Reminders}" FontSize="16" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <TextBlock Text="Recent days" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" />

      <Grid ColumnDefinitions="120,60,80,90,70,80,70,*">
        <TextBlock Grid.Column="0" Classes="head" Text="Day" />
        <TextBlock Grid.Column="1" Classes="head" Text="Breaks" />
        <TextBlock Grid.Column="2" Classes="head" Text="Sitting" />
        <TextBlock Grid.Column="3" Classes="head" Text="Longest sit" />
        <TextBlock Grid.Column="4" Classes="head" Text="Moving" />
        <TextBlock Grid.Column="5" Classes="head" Text="Standing" />
        <TextBlock Grid.Column="6" Classes="head" Text="Away" />
        <TextBlock Grid.Column="7" Classes="head" Text="Reminders (snoozed/skipped/ignored)" />
      </Grid>
    </StackPanel>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Days}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DayRow">
            <Grid ColumnDefinitions="120,60,80,90,70,80,70,*">
              <TextBlock Grid.Column="0" Classes="col" Text="{Binding Day}" FontWeight="{Binding IsToday, Converter={x:Static vm:Converters.BoldIfTrue}}" />
              <TextBlock Grid.Column="1" Classes="col" Text="{Binding Breaks}" />
              <TextBlock Grid.Column="2" Classes="col" Text="{Binding Sitting}" />
              <TextBlock Grid.Column="3" Classes="col" Text="{Binding LongestSit}" />
              <TextBlock Grid.Column="4" Classes="col" Text="{Binding Moving}" />
              <TextBlock Grid.Column="5" Classes="col" Text="{Binding Standing}" />
              <TextBlock Grid.Column="6" Classes="col" Text="{Binding Away}" />
              <TextBlock Grid.Column="7" Classes="col" Text="{Binding Reminders}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
