<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SitStand.App.ViewModels"
        x:Class="SitStand.App.Views.AlertWindow"
        x:DataType="vm:AlertViewModel"
        Title="SitStand"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowDecorations="BorderOnly">

  <Border Padding="28,24,28,24">
    <StackPanel Spacing="18">
      <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Message}" FontSize="14" TextWrapping="Wrap" Opacity="0.85" />

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <Button Classes="accent" Command="{Binding MovingCommand}" Content="I'm Moving" MinWidth="110" />
        <Button Command="{Binding StandingCommand}" Content="I'm Standing" MinWidth="110" IsVisible="{Binding ShowStanding}" />
        <Button Command="{Binding SnoozeCommand}" Content="{Binding SnoozeLabel}" MinWidth="110" />
        <Button Command="{Binding SkipCommand}" Content="Skip" MinWidth="70" />
      </StackPanel>

      <TextBlock Text="No answer for a few minutes counts as ignored."
                 FontSize="11" Opacity="0.55" HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
